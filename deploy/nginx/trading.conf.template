# Rendered by deploy/bootstrap.sh with envsubst (only ${DOMAIN} is substituted).
# Certbot then adds the 443/SSL blocks and the HTTP->HTTPS redirect in place.
# All upstreams are bound to 127.0.0.1 in docker-compose.yml, so nginx is the
# only way in from outside.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Main app: frontend + backend API/WebSocket
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    client_max_body_size 20M;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bot price-stream WebSockets stay open for hours
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Удалённый MCP (claude.ai / мобильный Claude). Секрет — в пути, проверяет сам сервис:
    # всё, кроме /mcp/<KANDLE_MCP_TOKEN>, там отдаёт 404. Streamable HTTP шлёт SSE — без буфера.
    location /mcp/ {
        proxy_pass http://127.0.0.1:8030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        access_log off;   # иначе токен из URL оседает в логах nginx
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Signals / screener service
server {
    listen 80;
    listen [::]:80;
    server_name signals.${DOMAIN};

    # Доступ — по токену kandle: nginx спрашивает бэкенд (/api/auth/verify) перед каждым запросом.
    # Чтение — любому вошедшему, изменение общих данных — только админу (политика в backend auth.py).
    auth_request /_kandle_auth;
    error_page 401 = @kandle_401;
    error_page 403 = @kandle_403;

    location = /_kandle_auth {
        internal;
        # CORS preflight браузера идёт без токена — пропускаем ($request_method — метод исходного запроса)
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://127.0.0.1:8000/api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI $request_uri;
    }
    # Отказ с CORS-заголовком — иначе браузер покажет «CORS error» вместо 401/403
    location @kandle_401 {
        add_header Access-Control-Allow-Origin "https://${DOMAIN}" always;
        return 401;
    }
    location @kandle_403 {
        add_header Access-Control-Allow-Origin "https://${DOMAIN}" always;
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Backtester web UI
server {
    listen 80;
    listen [::]:80;
    server_name backtester.${DOMAIN};

    client_max_body_size 100M;

    # Доступ — по токену kandle: nginx спрашивает бэкенд (/api/auth/verify) перед каждым запросом.
    # Чтение — любому вошедшему, изменение общих данных — только админу (политика в backend auth.py).
    auth_request /_kandle_auth;
    error_page 401 = @kandle_401;
    error_page 403 = @kandle_403;

    location = /_kandle_auth {
        internal;
        # CORS preflight браузера идёт без токена — пропускаем ($request_method — метод исходного запроса)
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://127.0.0.1:8000/api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI $request_uri;
    }
    # Отказ с CORS-заголовком — иначе браузер покажет «CORS error» вместо 401/403
    location @kandle_401 {
        add_header Access-Control-Allow-Origin "https://${DOMAIN}" always;
        return 401;
    }
    location @kandle_403 {
        add_header Access-Control-Allow-Origin "https://${DOMAIN}" always;
        return 403;
    }

    location = /health {
        auth_request off;
        proxy_pass http://127.0.0.1:8010/health;
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long backtests / optimizations
        proxy_read_timeout 600s;
    }
}

# Grafana (logs)
server {
    listen 80;
    listen [::]:80;
    server_name logs.${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:3002;
