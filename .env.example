# Database
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading123
POSTGRES_DB=trading_db
DATABASE_URL=postgresql+asyncpg://trading:trading123@postgres:5432/trading_db

# Redis
REDIS_URL=redis://redis:6379/0

# Bybit public price stream (price-tracker). Per-user trading keys for
# exchange=bybit bots are added in the UI (Bybit Accounts), not here.
BYBIT_TESTNET=false

# Cryptorg API (for actual trading)
CRYPTORG_WEBHOOK_URL=https://api.cryptorg.io/webhook
CRYPTORG_API_KEY=your_cryptorg_api_key
CRYPTORG_SECRET=your_cryptorg_secret

# Backend
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Fernet key for encrypting Bybit API keys in the DB. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Admin dashboard (/admin) — must match the username you log in with.
# Leave empty to deny everyone (fails closed, not open).
ADMIN_USERNAME=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SIGNALS_URL=http://localhost:8020
NEXT_PUBLIC_BACKTESTER_URL=http://localhost:8010

# Backtester (separate DB, not merged with trading_db)
BACKTESTER_DB_USER=backtester
BACKTESTER_DB_PASSWORD=changeme
BACKTESTER_CORS_ORIGINS=http://localhost:3000
